# Copy this file to .env and fill in real values before running.

# --- Server ---
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

# --- MongoDB Atlas ---
# Create a free M0 cluster at https://cloud.mongodb.com and paste its connection string here.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/arohi?retryWrites=true&w=majority

# --- Auth secrets (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ---
CUSTOMER_ACCESS_SECRET=changeme_customer_access_secret
CUSTOMER_REFRESH_SECRET=changeme_customer_refresh_secret
ADMIN_ACCESS_SECRET=changeme_admin_access_secret
ADMIN_REFRESH_SECRET=changeme_admin_refresh_secret

# --- Cloudinary (media CDN) - https://cloudinary.com free tier ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Razorpay (payments) - https://razorpay.com test keys ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- First admin bootstrap (used only by the seed script) ---
SEED_ADMIN_EMAIL=admin@arohibymegha.com
SEED_ADMIN_PASSWORD=ChangeThisPassword123!
