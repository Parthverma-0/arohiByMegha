# Copy this file to .env and fill in real values before running.

# --- Server ---
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

# --- MongoDB Atlas ---
# Create a free M0 cluster at https://cloud.mongodb.com and paste its connection string here.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/arohi?retryWrites=true&w=majority

# --- Auth secrets (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ---
CUSTOMER_ACCESS_SECRET=changeme_customer_access_secret
CUSTOMER_REFRESH_SECRET=changeme_customer_refresh_secret
ADMIN_ACCESS_SECRET=changeme_admin_access_secret
ADMIN_REFRESH_SECRET=changeme_admin_refresh_secret

# --- Cloudinary (media CDN) - https://cloudinary.com free tier ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Razorpay (payments) - https://dashboard.razorpay.com -> Account & Settings -> API Keys ---
# Test keys start with rzp_test_, live keys with rzp_live_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional but recommended: Settings -> Webhooks, URL https://<your-domain>/api/orders/razorpay/webhook,
# events payment.captured + order.paid; paste the secret you choose there.
RAZORPAY_WEBHOOK_SECRET=

# --- First admin bootstrap (used only by the seed script) ---
SEED_ADMIN_EMAIL=admin@arohibymegha.com
SEED_ADMIN_PASSWORD=ChangeThisPassword123!

# Invoice emails (Gmail). Use an App Password, not the normal Gmail password:
# Google Account -> Security -> 2-Step Verification -> App passwords.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Printed on invoices (all optional; name defaults to "Arohi by Megha")
INVOICE_BUSINESS_NAME=Arohi by Megha
INVOICE_BUSINESS_ADDRESS=
INVOICE_BUSINESS_PHONE=
INVOICE_BUSINESS_EMAIL=
INVOICE_GSTIN=
