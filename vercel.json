{
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "server/node_modules/{pdfkit/js/data,country-state-city/lib/cjs/assets}/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/admin/(.*)", "destination": "/admin/index.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
